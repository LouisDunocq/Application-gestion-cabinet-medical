<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.PatientController">
   <top>
      <ToolBar BorderPane.alignment="CENTER">
        <items>
          <Button text="Ajouter un Patient" onAction="#handleAjouter"/>
        </items>
      </ToolBar>
   </top>
   <center>
      <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">
        <items>
            <TableView fx:id="patientTable">
              <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="150.0" />
                <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150.0" />
              </columns>
            </TableView>
            
            <StackPane>
               <children>
                  
                  <VBox fx:id="panelDetails" spacing="15.0" padding="15">
                     <children>
                        <Label text="Détails du Patient" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <GridPane vgap="10.0" hgap="10.0">
                          <columnConstraints>
                            <ColumnConstraints prefWidth="130.0" />
                            <ColumnConstraints prefWidth="200.0" />
                          </columnConstraints>
                           <children>
                              <Label text="Nom complet :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                              <Label fx:id="lblNomComplet" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                              
                              <Label text="Téléphone :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                              <Label fx:id="lblTelephone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                              
                              <Label text="N° Sécurité Sociale :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                              <Label fx:id="lblSecu" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                              
                              <Label text="Taux Remb. :" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                              <Label fx:id="lblTaux" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                           </children>
                        </GridPane>
                        <HBox spacing="10.0" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                           <children>
                              <Button fx:id="btnModifier" text="Modifier" onAction="#handleModifier" disable="true"/>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <VBox fx:id="panelFormulaire" spacing="15.0" padding="15" visible="false" style="-fx-background-color: #f9f9f9;">
                     <children>
                        <Label fx:id="lblTitreForm" text="Ajouter un nouveau Patient" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                        <GridPane vgap="10.0" hgap="10.0">
                           <children>
                              <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                              
                              <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtPrenom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                              
                              <Label text="Téléphone :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtTelephone" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                              
                              <Label text="N° Sécurité Sociale :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtSecu" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                              
                              <Label text="Taux de Remb. (ex: 0.7) :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtTaux" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                           </children>
                        </GridPane>
                        <HBox spacing="10.0" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                           <children>
                              <Button text="Annuler" onAction="#handleAnnuler"/>
                              <Button text="Enregistrer" onAction="#handleEnregistrer" style="-fx-base: #4CAF50;"/>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
               </children>
            </StackPane>
        </items>
      </SplitPane>
   </center>
</BorderPane>