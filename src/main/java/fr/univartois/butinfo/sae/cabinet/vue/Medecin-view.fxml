<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedecinController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <items>
                <Button text="Ajouter un Medecin" onAction="#handleAjouter"/>
            </items>
        </ToolBar>
    </top>
    <center>
        <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">
            <items>
                <TableView fx:id="medecinTable">
                    <columns>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="150.0" />
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150.0" />
                    </columns>
                </TableView>

                <StackPane>
                    <children>

                        <VBox fx:id="panelDetails" spacing="15.0" padding="15">
                            <children>
                                <Label text="Détails du Medecin" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <GridPane vgap="10.0" hgap="10.0">
                                    <children>
                                        <Label text="Nom Complet :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblNomComplet" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Tarif Horaire :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblTarifHoraire" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Téléphone :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblTelephone" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Email :" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                        <Label text="Spécialité :" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblSpecialite" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                    </children>
                                </GridPane>
                                <Button fx:id="btnModifier" text="Modifier" onAction="#handleModifier" disable="true"/>
                            </children>
                        </VBox>

                        <VBox fx:id="panelFormulaire" spacing="15.0" padding="15" visible="false">
                            <children>
                                <Label fx:id="lblTitreForm" text="Ajouter un nouveau Médecin" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <GridPane vgap="10.0" hgap="10.0">
                                    <children>
                                        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtPrenom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Tarif Horaire :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtHoraire" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                        <Label text="Téléphone :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtTelephone" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                        <Label text="Email :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                        <Label text="Specialité :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtSpecialite" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                                    </children>
                                </GridPane>

                                <Label fx:id="lblErreur" text="" style="-fx-text-fill: red; -fx-font-weight: bold;" />

                                <HBox spacing="10.0" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Button text="Annuler" onAction="#handleAnnuler"/>
                                        <Button text="Enregistrer" onAction="#handleEnregistrer" style="-fx-base: #4CAF50;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>