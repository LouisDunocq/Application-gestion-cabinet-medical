<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedicamentsController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <items>
                <Button text="Ajouter un Médicament" onAction="#handleAjouter"/>
            </items>
        </ToolBar>
    </top>
    <center>
        <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">
            <items>
                <TableView fx:id="medicamentTable">
                    <columns>
                        <TableColumn fx:id="colNom" text="Nom du Médicament" prefWidth="180.0" />
                        <TableColumn fx:id="colPrix" text="Prix (€)" prefWidth="120.0" />
                    </columns>
                </TableView>

                <StackPane>
                    <children>

                        <VBox fx:id="panelDetails" spacing="15.0" padding="15">
                            <children>
                                <Label text="Détails du Médicament" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <GridPane vgap="10.0" hgap="10.0">
                                    <children>
                                        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblNom" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                        <Label text="Prix :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblPrix" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Description :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                                        <Label fx:id="lblDescription" GridPane.rowIndex="2" GridPane.columnIndex="1" wrapText="true"/>
                                    </children>
                                </GridPane>
                                <Button fx:id="btnModifier" text="Modifier" onAction="#handleModifier" disable="true"/>
                            </children>
                        </VBox>

                        <VBox fx:id="panelFormulaire" spacing="15.0" padding="15" visible="false">
                            <children>
                                <Label fx:id="lblTitreForm" text="Ajouter un nouveau Médicament" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                                <GridPane vgap="10.0" hgap="10.0">
                                    <children>
                                        <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtNom" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250.0"/>

                                        <Label text="Prix (€) :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <TextField fx:id="txtPrix" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                        <Label text="Description :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <TextArea fx:id="txtDescription" GridPane.rowIndex="2" GridPane.columnIndex="1" prefRowCount="4" prefWidth="250.0" wrapText="true"/>
                                    </children>
                                </GridPane>

                                <Label fx:id="lblErreur" text="" style="-fx-text-fill: red; -fx-font-weight: bold;" />

                                <HBox spacing="10.0" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Button text="Annuler" onAction="#handleAnnuler"/>
                                        <Button text="Enregistrer" onAction="#handleEnregistrer" style="-fx-base: #4CAF50;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>